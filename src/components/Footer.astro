---
const sourceUrl = "https://git.radical.systems/uded/grafana-streamdeck";
---
<footer class="border-t border-(--color-border) mt-8">
  <div class="mx-auto max-w-5xl px-6 py-10 flex items-center justify-between flex-wrap gap-4">
    <nav class="flex items-center gap-6 text-sm">
      <a href="mailto:support@madeathing.studio" class="text-(--color-fg-muted) hover:text-(--color-fg) transition-colors">Support</a>
      <a href={sourceUrl} rel="noopener" class="text-(--color-fg-muted) hover:text-(--color-fg) transition-colors">Source</a>
      <a href="/privacy" class="text-(--color-fg-muted) hover:text-(--color-fg) transition-colors">Privacy</a>
    </nav>
    <div class="text-xs text-(--color-fg-dim)">© 2026 Made A Thing Studio</div>
  </div>
</footer>
